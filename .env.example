# Environment variables Jarvis reads. They override config.toml.
# Jarvis does not load .env files automatically; export these in your shell
# (or, from Phase 3, set them in the Launch Agent). Never put secrets in logs.

# Path to an alternative config file (default: ~/Library/Application Support/Jarvis/config.toml)
# JARVIS_CONFIG=~/Library/Application Support/Jarvis/config.toml

# Validate and describe actions without executing them (true/false)
# JARVIS_DRY_RUN=false

# DEBUG, INFO, WARNING or ERROR
# JARVIS_LOG_LEVEL=INFO

# Log directory (default: ~/Library/Logs/Jarvis)
# JARVIS_LOG_DIR=~/Library/Logs/Jarvis

# Use the local AI model for requests the built-in rules don't understand (true/false)
# JARVIS_AI_ENABLED=true

# GGUF model file
# (default: ~/Library/Application Support/Jarvis/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf)
# JARVIS_MODEL_PATH=~/models/my-model.gguf

# Memory ([memory]) and voice ([voice]) settings live in config.toml only:
# `jarvis config init` writes an example with every option.
